{
  "version": "M312.2",
  "purpose": "Inventory only. No migration, runtime wiring, or storage changes.",
  "canonical_brain": {
    "service": "application.brain.service.BrainService",
    "model": "domain.brain.BrainMemory",
    "repository": "infrastructure.brain.AtomicJsonBrainRepository",
    "runtime_connected": false
  },
  "systems": [
    {
      "id": "official_personal_memory",
      "kind": "persistent_personal_memory",
      "entry_point": "app.memory_consolidation.OfficialMemoryGateway",
      "contracts": ["core.memory.MemoryStore"],
      "storage": [".roby/memory/owner-*.sqlite3"],
      "repository": "infrastructure.repositories.sqlite_memory_store.SQLiteMemoryStore",
      "writers": ["OfficialMemoryGateway.remember", "OfficialMemoryGateway.intercept"],
      "readers": ["OfficialMemoryGateway.recall", "OfficialMemoryGateway.intercept"],
      "runtime_status": "active",
      "brain_strategy": "read_only_adapter_first",
      "migration_risk": "medium"
    },
    {
      "id": "cognitive_learning_memory",
      "kind": "learning_and_recall_pipeline",
      "entry_point": "core.cognitive_memory.CognitiveLearningPolicy",
      "contracts": ["core.cognitive_memory_store", "core.cognitive_memory_recall"],
      "storage": ["SQLite configured by cognitive memory runtime"],
      "repository": "core.cognitive_memory_store",
      "writers": ["cognitive learning integration"],
      "readers": ["cognitive recall integration"],
      "runtime_status": "present_requires_wiring_confirmation",
      "brain_strategy": "adapter_after_official_memory",
      "migration_risk": "high"
    },
    {
      "id": "executive_working_memory",
      "kind": "short_lived_working_state",
      "entry_point": "app.executive_working_memory",
      "contracts": ["core.working_memory"],
      "storage": ["runtime/in-memory unless configured otherwise"],
      "repository": null,
      "writers": ["executive runtime"],
      "readers": ["executive runtime"],
      "runtime_status": "present_requires_wiring_confirmation",
      "brain_strategy": "keep_ephemeral_behind_brain",
      "migration_risk": "low"
    },
    {
      "id": "cognitive_episodic_memory",
      "kind": "episodic_memory",
      "entry_point": "app.cognitive_episodic_memory",
      "contracts": ["core.adaptive_cognition.episodic_memory"],
      "storage": ["implementation-dependent"],
      "repository": null,
      "writers": ["episodic runtime"],
      "readers": ["episodic runtime"],
      "runtime_status": "present_requires_wiring_confirmation",
      "brain_strategy": "normalize_to_episode_type",
      "migration_risk": "medium"
    },
    {
      "id": "relationship_memory",
      "kind": "relationship_and_preference_state",
      "entry_point": "core.relationship_memory",
      "contracts": [],
      "storage": ["implementation-dependent"],
      "repository": null,
      "writers": ["relationship runtime"],
      "readers": ["relationship runtime"],
      "runtime_status": "present_requires_wiring_confirmation",
      "brain_strategy": "profile_adapter_with_confidence",
      "migration_risk": "high"
    },
    {
      "id": "identity_profiles",
      "kind": "identity_and_profile",
      "entry_point": "core.local_identity_profile",
      "contracts": ["core.identity", "app.personal_profile_factory"],
      "storage": [".roby/identity/profiles.json", ".roby/identity/sessions.json"],
      "repository": null,
      "writers": ["identity/profile runtime"],
      "readers": ["identity/profile runtime"],
      "runtime_status": "active_or_persisted",
      "brain_strategy": "read_only_profile_adapter",
      "migration_risk": "high"
    },
    {
      "id": "household_memory",
      "kind": "household_knowledge",
      "entry_point": "core.household_memory",
      "contracts": [],
      "storage": [".roby/household_knowledge.db"],
      "repository": "infrastructure.repositories.sqlite_household_memory_repository",
      "writers": ["household memory services"],
      "readers": ["household memory services"],
      "runtime_status": "persisted_requires_wiring_confirmation",
      "brain_strategy": "domain_specific_adapter",
      "migration_risk": "medium"
    },
    {
      "id": "goals_and_projects",
      "kind": "goals_projects_and_agenda",
      "entry_point": "app.executive_goal_manager",
      "contracts": ["core.household_goals", "app.household_goals"],
      "storage": [".roby/household_goals.db", ".roby/household_projects.db", ".roby/cognitive_agenda.db"],
      "repository": "infrastructure.repositories.sqlite_household_goal_repository",
      "writers": ["goal and agenda managers"],
      "readers": ["goal review and agenda reasoning"],
      "runtime_status": "persisted_requires_wiring_confirmation",
      "brain_strategy": "first_visible_project_memory_candidate",
      "migration_risk": "medium"
    },
    {
      "id": "reminders",
      "kind": "scheduled_follow_up_state",
      "entry_point": "domain.reminders",
      "contracts": ["application.reminders"],
      "storage": [".roby/reminders.db"],
      "repository": "infrastructure.persistence.sqlite.reminder_repository",
      "writers": ["create/cancel/complete/snooze reminder use cases"],
      "readers": ["reminder awareness runtime"],
      "runtime_status": "active_or_persisted",
      "brain_strategy": "reference_only_do_not_duplicate_scheduler",
      "migration_risk": "high"
    },
    {
      "id": "conversation_context",
      "kind": "bounded_session_context",
      "entry_point": "app.context_continuity_runtime.OfficialContextContinuityRuntimeGateway",
      "contracts": ["core.conversational_context_continuity", "core.conversation_context_curation"],
      "storage": [".roby/conversation_turns.jsonl", "request.recent_context"],
      "repository": null,
      "writers": ["conversation runtime"],
      "readers": ["context continuity runtime"],
      "runtime_status": "active",
      "brain_strategy": "keep_short_lived_and_session_scoped",
      "migration_risk": "medium"
    },
    {
      "id": "ambient_context",
      "kind": "explicit_ambient_observation",
      "entry_point": "app.ambient_context_runtime.OfficialAmbientContextRuntimeGateway",
      "contracts": ["core.ambient_context_foundation"],
      "storage": ["runtime snapshot"],
      "repository": null,
      "writers": ["explicit ambient context registration"],
      "readers": ["ambient context status and reasoning"],
      "runtime_status": "active_explicit_only",
      "brain_strategy": "store_only_confirmed_observations_with_expiry",
      "migration_risk": "medium"
    },
    {
      "id": "proactive_state",
      "kind": "deduplication_and_notification_state",
      "entry_point": "app.proactive_verified_runtime",
      "contracts": [],
      "storage": [".roby/proactive_verified_state.json"],
      "repository": null,
      "writers": ["proactive verified runtime"],
      "readers": ["proactive verified runtime"],
      "runtime_status": "active",
      "brain_strategy": "keep_operational_state_outside_personal_memory",
      "migration_risk": "low"
    }
  ],
  "integration_order": [
    "official_personal_memory",
    "goals_and_projects",
    "conversation_context",
    "identity_profiles",
    "cognitive_episodic_memory",
    "cognitive_learning_memory",
    "relationship_memory",
    "household_memory",
    "reminders"
  ],
  "excluded_from_migration": [
    "credentials and tokens",
    "model files",
    "cache directories",
    "proactive deduplication state as personal memory",
    "raw microphone noise"
  ]
}
