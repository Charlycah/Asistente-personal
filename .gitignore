.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Archivos temporales y copias locales
*.tmp
*.bak
*.swp
*.swo

# Archivos comprimidos de entrega
*.zip
*.7z
*.rar

# Entornos de desarrollo
.idea/
.vscode/
